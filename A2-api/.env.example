# Copy this file to ".env" and fill in your own MySQL settings.
# .env must NOT be committed to GitHub.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=charityevents_db

# Port the API server listens on
PORT=3000

# Allowed origin for the browser client (the client-side website).
# Use * only during local development.
CORS_ORIGIN=*
